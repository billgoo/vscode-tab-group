{
  "name": "tab-group",
  "displayName": "Tab Group",
  "description": "Organize VS Code editor tabs into persistent, named groups.",
  "publisher": "jiapeiyao",
  "version": "3.0.1",
  "license": "MIT",
  "homepage": "https://github.com/billgoo/vscode-tab-group#readme",
  "galleryBanner": {
    "color": "#2d6a4f",
    "theme": "dark"
  },
  "keywords": [
    "tabs",
    "tab groups",
    "editor tabs",
    "productivity",
    "workspace"
  ],
  "contributors": [
    {
      "name": "Jiapei Yao",
      "email": "charlesyjp@gmail.com"
    },
    {
      "name": "Bill Goo",
      "email": "billgoo0813@gmail.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/billgoo/vscode-tab-group"
  },
  "bugs": {
    "url": "https://github.com/billgoo/vscode-tab-group/issues"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.71.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tabs",
          "title": "Tab Group",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "tabs": [
        {
          "id": "tabsTreeView",
          "name": "Tabs",
          "icon": "media/icon.svg",
          "contextualTitle": "Tabs"
        },
        {
          "id": "recentTabsTreeView",
          "name": "Recent Tabs",
          "icon": "media/icon.svg",
          "contextualTitle": "Recent Tabs"
        },
        {
          "id": "savedGroupsTreeView",
          "name": "Saved Groups",
          "icon": "media/icon.svg",
          "contextualTitle": "Saved Groups",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "tabsTreeView.tab.close",
        "title": "Close",
        "icon": "$(close)"
      },
      {
        "command": "tabsTreeView.tab.ungroup",
        "title": "Ungroup",
        "icon": "$(array)"
      },
      {
        "command": "tabsTreeView.group.rename",
        "title": "Rename Group",
        "icon": "$(edit)"
      },
      {
        "command": "tabsTreeView.group.changeColor",
        "title": "Change Group Color",
        "icon": "$(symbol-color)"
      },
      {
        "command": "tabsTreeView.sortTabsAscending",
        "title": "Sort: A to Z",
        "icon": "$(arrow-up)"
      },
      {
        "command": "tabsTreeView.sortTabsDescending",
        "title": "Sort: Z to A",
        "icon": "$(arrow-down)"
      },
      {
        "command": "tabsTreeView.group.save",
        "title": "Save Group...",
        "icon": "$(save)"
      },
      {
        "command": "tabsTreeView.savedGroup.restore",
        "title": "Restore Saved Group...",
        "icon": "$(folder-opened)"
      },
      {
        "command": "tabsTreeView.savedGroup.delete",
        "title": "Delete Saved Group...",
        "icon": "$(trash)"
      },
      {
        "command": "tabsTreeView.savedGroups.restoreAll",
        "title": "Restore All Saved Groups",
        "icon": "$(folder-opened)"
      },
      {
        "command": "tabsTreeView.savedGroups.deleteAll",
        "title": "Delete All Saved Groups",
        "icon": "$(trash)"
      },
      {
        "command": "tabsTreeView.savedGroups.sortAscending",
        "title": "Sort Saved Groups: A to Z",
        "icon": "$(arrow-up)"
      },
      {
        "command": "tabsTreeView.savedGroups.sortDescending",
        "title": "Sort Saved Groups: Z to A",
        "icon": "$(arrow-down)"
      },
      {
        "command": "tabsTreeView.group.cancelGroup",
        "title": "Cancel Group",
        "icon": "$(array)"
      },
      {
        "command": "tabsTreeView.group.close",
        "title": "Close Grouped Tabs",
        "icon": "$(close)"
      },
      {
        "command": "tabsTreeView.enableSortMode",
        "title": "Sort Mode",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "tabsTreeView.disableSortMode",
        "title": "Done",
        "icon": "$(check)"
      },
      {
        "command": "tabsTreeView.collapseAll",
        "title": "Collapse All",
        "icon": "$(collapse-all)"
      },
      {
        "command": "tabsTreeView.expandAll",
        "title": "Expand All",
        "icon": "$(expand-all)"
      },
      {
        "command": "tabsTreeView.savedGroups.collapseAll",
        "title": "Collapse All Saved Groups",
        "icon": "$(collapse-all)"
      },
      {
        "command": "tabsTreeView.savedGroups.expandAll",
        "title": "Expand All Saved Groups",
        "icon": "$(expand-all)"
      },
      {
        "command": "tabsTreeView.reset",
        "title": "Reset All",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "tabsTreeView.tab.ungroup",
          "when": "view =~ /^(tabsTreeView|recentTabsTreeView)/ && viewItem == 'grouped-tab'",
          "group": "inline@0"
        },
        {
          "command": "tabsTreeView.tab.close",
          "when": "view =~ /^(tabsTreeView|recentTabsTreeView)/ && viewItem =~ /tab/",
          "group": "inline@1"
        },
        {
          "command": "tabsTreeView.group.rename",
          "when": "view =~ /^(tabsTreeView|recentTabsTreeView)/ && viewItem =~ /^group-sort-/",
          "group": "inline@0"
        },
        {
          "command": "tabsTreeView.group.changeColor",
          "when": "view =~ /^(tabsTreeView|recentTabsTreeView)/ && viewItem =~ /^group-sort-/",
          "group": "inline@1"
        },
        {
          "command": "tabsTreeView.sortTabsAscending",
          "when": "view == tabsTreeView && viewItem == 'group-sort-ascending'",
          "group": "inline@2"
        },
        {
          "command": "tabsTreeView.sortTabsDescending",
          "when": "view == tabsTreeView && viewItem == 'group-sort-descending'",
          "group": "inline@2"
        },
        {
          "command": "tabsTreeView.group.save",
          "when": "view =~ /^tabsTreeView/ && viewItem =~ /^group-sort-/",
          "group": "inline@3"
        },
        {
          "command": "tabsTreeView.group.cancelGroup",
          "when": "view =~ /^(tabsTreeView|recentTabsTreeView)/ && viewItem =~ /^group-sort-/",
          "group": "inline@4"
        },
        {
          "command": "tabsTreeView.group.close",
          "when": "view =~ /^(tabsTreeView|recentTabsTreeView)/ && viewItem =~ /^group-sort-/",
          "group": "inline@5"
        },
        {
          "command": "tabsTreeView.savedGroup.restore",
          "when": "view == savedGroupsTreeView && viewItem == 'saved-group'",
          "group": "inline@0"
        },
        {
          "command": "tabsTreeView.savedGroup.delete",
          "when": "view == savedGroupsTreeView && viewItem == 'saved-group'",
          "group": "inline@1"
        }
      ],
      "view/title": [
        {
          "command": "tabsTreeView.savedGroups.deleteAll",
          "when": "view == savedGroupsTreeView",
          "group": "navigation@3"
        },
        {
          "command": "tabsTreeView.savedGroups.restoreAll",
          "when": "view == savedGroupsTreeView",
          "group": "navigation@2"
        },
        {
          "command": "tabsTreeView.savedGroups.sortAscending",
          "when": "view == savedGroupsTreeView && tabGroup.savedGroups.sort:nextAscending",
          "group": "navigation@1"
        },
        {
          "command": "tabsTreeView.savedGroups.sortDescending",
          "when": "view == savedGroupsTreeView && !tabGroup.savedGroups.sort:nextAscending",
          "group": "navigation@1"
        },
        {
          "command": "tabsTreeView.savedGroups.collapseAll",
          "when": "view == savedGroupsTreeView && tabGroup.savedGroups:allExpanded",
          "group": "navigation@0"
        },
        {
          "command": "tabsTreeView.savedGroups.expandAll",
          "when": "view == savedGroupsTreeView && !tabGroup.savedGroups:allExpanded",
          "group": "navigation@0"
        },
        {
          "command": "tabsTreeView.enableSortMode",
          "when": "view =~ /^tabsTreeView/ && !tabGroup.sortMode:enabled",
          "group": "navigation@1"
        },
        {
          "command": "tabsTreeView.disableSortMode",
          "when": "view =~ /^tabsTreeView/ && tabGroup.sortMode:enabled",
          "group": "navigation@1"
        },
        {
          "command": "tabsTreeView.group.changeColor",
          "when": "view =~ /^tabsTreeView/ && tabGroup.selectedGroup",
          "group": "navigation@3"
        },
        {
          "command": "tabsTreeView.sortTabsAscending",
          "when": "view =~ /^tabsTreeView/ && !tabGroup.sortMode:enabled && tabGroup.sort:nextRootAscending",
          "group": "navigation@2"
        },
        {
          "command": "tabsTreeView.sortTabsDescending",
          "when": "view =~ /^tabsTreeView/ && !tabGroup.sortMode:enabled && !tabGroup.sort:nextRootAscending",
          "group": "navigation@2"
        },
        {
          "command": "tabsTreeView.collapseAll",
          "when": "view =~ /^tabsTreeView/ && !tabGroup.groups:allCollapsed",
          "group": "navigation@8"
        },
        {
          "command": "tabsTreeView.expandAll",
          "when": "view =~ /^tabsTreeView/ && tabGroup.groups:allCollapsed",
          "group": "navigation@8"
        },
        {
          "command": "tabsTreeView.reset",
          "when": "view =~ /^tabsTreeView/",
          "group": "navigation@9"
        }
      ]
    }
  },
  "scripts": {
    "clean": "rimraf out",
    "compile": "npm run clean && tsc -p ./",
    "format-project": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint src --ext .ts",
    "test": "npm run test:unit",
    "test:unit": "jest",
    "test:e2e": "npm run compile && vscode-test",
    "test:all": "npm run lint && npm run test:unit && npm run test:e2e",
    "pre-commit": "npm run lint && npm run test:unit && npm run compile",
    "package": "vsce package",
    "prepare": "husky",
    "publish": "vsce publish",
    "release:check": "node scripts/check-release.js",
    "publish:local": "node scripts/publish-local.js",
    "vscode:prepublish": "npm run clean && tsc -p ./ --sourceMap false",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.3.0",
    "@types/vscode": "^1.134.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-util": "^30.4.1",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
